<domain type="kvm">
  <name>test</name>
  <cpu mode="host-passthrough" check="none" migratable="on" />
  <os>
    <type arch="x86_64" machine="pc">hvm</type>
    <loader readonly="yes" type="pflash">/fake/cwd/loader</loader>
    <nvram format="qcow2">/fake/cwd/nvram</nvram>
  </os>
  <memory unit="B">4294967296</memory>
  <vcpu>2</vcpu>
  <devices>
    <disk device="disk" type="file">
      <source file="/fake/cwd/somewhere" />
      <driver name="qemu" type="qcow2" />
      <target dev="sda" />
    </disk>
    <disk device="disk" type="file">
      <source file="/fake/cwd/somewhere" />
      <driver name="qemu" type="qcow2" />
      <target dev="sdb" />
    </disk>
    <controller index="0" type="pci" model="pcie-root" />
    <controller index="0" type="usb" />
    <interface type="network">
      <source network="test" />
      <model type="virtio" />
    </interface>
    <input type="mouse" bus="usb" />
    <input type="keyboard" bus="usb" />
    <graphics type="vnc" port="-1" />
    <video>
      <model type="virtio" />
    </video>
    <console type="pty">
      <target type="serial" />
    </console>
  </devices>
</domain>