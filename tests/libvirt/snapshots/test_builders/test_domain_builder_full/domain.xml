<domain type="qemu">
  <name>test</name>
  <os>
    <type arch="x86_64" machine="q35">hvm</type>
    <kernel>/fake/cwd/vmlinux</kernel>
    <initrd>/fake/cwd/initrd.gz</initrd>
    <cmdline>console=ttyS0 root=/dev/sda1</cmdline>
    <loader readonly="yes" type="pflash">/fake/cwd/loader</loader>
    <nvram format="qcow2">/fake/cwd/nvram</nvram>
  </os>
  <memory unit="B">4294967296</memory>
  <vcpu>2</vcpu>
  <features>
    <apic />
    <acpi />
  </features>
  <devices>
    <disk device="disk" type="file">
      <source file="/fake/cwd/somewhere" />
      <driver name="qemu" type="qcow2" />
      <target dev="sda" bus="sata" />
    </disk>
    <disk device="disk" type="file">
      <source file="/fake/cwd/somewhere" />
      <driver name="qemu" type="qcow2" />
      <target dev="sdb" bus="sata" />
    </disk>
    <controller index="0" type="pci" model="pcie-root" />
    <controller index="0" type="usb" />
    <interface type="network">
      <source network="test" />
      <model type="e1000" />
    </interface>
    <input type="tablet" bus="usb" />
    <input type="keyboard" bus="usb" />
    <graphics type="vnc" port="-1" />
    <video>
      <model type="virtio" />
    </video>
    <console type="pty">
      <target type="serial" />
    </console>
  </devices>
</domain>