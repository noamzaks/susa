<domain xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0" type="qemu">
  <devices>
    <console type="pty" />
    <controller index="0" type="usb" />
    <graphics port="-1" type="vnc" />
    <input bus="usb" type="tablet" />
    <input bus="usb" type="keyboard" />
    <interface type="network">
      <mac address="52:54:00:12:34:56" />
      <model type="e1000" />
      <source network="test" />
    </interface>
    <video>
      <model type="virtio" />
    </video>
  </devices>
  <features />
  <name>test</name>
  <os>
    <type arch="armv7l" machine="virt">hvm</type>
  </os>
  <qemu:commandline>
    <qemu:arg value="-machine" />
    <qemu:arg value="virt,highmem=off" />
  </qemu:commandline>
</domain>