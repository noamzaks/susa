<domain type="qemu">
  <name>test</name>
  <os>
    <type arch="x86_64" machine="q35">hvm</type>
  </os>
  <features>
    <acpi />
  </features>
  <devices>
    <controller index="0" type="usb" />
    <interface type="network">
      <source network="test" />
      <mac address="52:54:00:12:34:56" />
