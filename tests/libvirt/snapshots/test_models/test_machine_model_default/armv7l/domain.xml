<domain xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0" type="qemu">
  <name>test</name>
  <os>
    <type arch="armv7l" machine="virt">hvm</type>
  </os>
  <devices>
    <disk device="disk" type="file">
      <source file="/fake/cwd/somewhere" />
      <driver name="qemu" type="qcow2" />
      <target dev="vda" bus="virtio" />
    </disk>
    <controller index="0" type="pci" model="pcie-root" />
    <controller index="0" type="usb" model="qemu-xhci" />
    <input type="tablet" bus="usb" />
    <input type="keyboard" bus="usb" />
    <graphics type="vnc" port="-1" />
    <video>
      <model type="virtio" />
    </video>
    <console type="pty">
      <target type="serial" />
    </console>
  </devices>
  <qemu:commandline>
    <qemu:arg value="-machine" />
    <qemu:arg value="virt,highmem=off" />
  </qemu:commandline>
</domain>