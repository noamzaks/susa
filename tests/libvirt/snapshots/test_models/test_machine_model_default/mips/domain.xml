<domain type="qemu">
  <name>test</name>
  <os>
    <type arch="mips" machine="malta">hvm</type>
  </os>
  <devices>
    <disk device="disk" type="file">
      <source file="/fake/cwd/somewhere" />
      <driver name="qemu" type="qcow2" />
      <target dev="hda" bus="ide" />
    </disk>
    <controller index="0" type="usb">
      <address type="pci" domain="0" bus="0" slot="11" function="0" />
    </controller>
    <input type="tablet" bus="usb" />
    <input type="keyboard" bus="usb" />
    <graphics type="vnc" port="-1" />
    <video>
      <model type="cirrus" />
    </video>
    <console type="pty">
      <target type="serial" />
    </console>
  </devices>
</domain>