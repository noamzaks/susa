<domain xmlns:qemu="http://libvirt.org/schemas/domain/qemu/1.0" type="qemu">
  <name>test</name>
  <os>
    <type arch="i686" machine="q35">hvm</type>
  </os>
  <features>
    <apic />
    <acpi />
  </features>
  <devices>
    <disk device="disk" type="file">
      <source file="/fake/cwd/somewhere" />
      <driver name="qemu" type="qcow2" />
      <target dev="sda" bus="sata" />
    </disk>
    <controller index="0" type="pci" model="pcie-root" />
    <controller index="0" type="usb" />
    <input type="tablet" bus="usb" />
    <input type="keyboard" bus="usb" />
    <graphics type="vnc" port="-1" />
    <video>
      <model type="virtio" />
    </video>
    <console type="pty">
      <target type="serial" />
    </console>
  </devices>
  <qemu:commandline>
    <qemu:arg value="-cpu" />
    <qemu:arg value="qemu32,family=4" />
  </qemu:commandline>
</domain>